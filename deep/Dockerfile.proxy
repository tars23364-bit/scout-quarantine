# Allowlisting CONNECT proxy for the deep reviewer box (squid on alpine).
# Why squid over tinyproxy: exact-host ACLs (`dstdomain`) instead of regex filters that need
# careful anchoring, and an access log that records every request with its allow/deny result
# in one structured line, which is the egress evidence the post-run check parses.
FROM alpine:3.22
RUN apk add --no-cache squid=6.12-r0 && squid -v | head -1
COPY squid.conf /etc/squid/squid.conf
LABEL scout.quarantine=true scout.role=deep-proxy
USER squid
EXPOSE 3128
ENTRYPOINT ["squid", "-N", "-f", "/etc/squid/squid.conf"]
