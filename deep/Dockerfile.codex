# Codex reviewer box for `scout --deep` (the second model family, §2b of the design).
# Same base and same runtime hardening as the Claude box (deep-review.sh box_flags): read-only
# root, cap-drop ALL, internal network, tmpfs HOME, /repo read-only. The image holds only the
# pinned CLI, a non-root user, and an entrypoint that builds a NON-REFRESHABLE auth file on the
# tmpfs HOME from runtime env vars (see codex-entry.sh). No credential ever enters a layer.
FROM node:22-bookworm-slim

# Pinned to the host's codex so the feature gating (`codex features list`) matches the build
# whose --disable flags were proven in a live `codex exec`.
ARG CODEX_VERSION=0.153.0
ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    CODEX_HOME=/home/reviewer/.codex

# node:*-slim has no system CA store (Node bundles its own roots; the Claude box never needed
# one). codex's TLS stack reads the system store, so without this every connection fails with
# "invalid peer certificate: UnknownIssuer" even through a working CONNECT tunnel.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g --no-audit --no-fund "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force \
    && codex --version

RUN useradd -u 10001 -M -d /home/reviewer -s /usr/sbin/nologin reviewer \
    && mkdir -p /work /repo /out /home/reviewer \
    && chown reviewer:reviewer /work /out /home/reviewer
COPY codex-entry.sh /usr/local/bin/scout-codex-entry
RUN chmod 0755 /usr/local/bin/scout-codex-entry
LABEL scout.quarantine=true scout.role=deep-codex
USER reviewer
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/scout-codex-entry"]
